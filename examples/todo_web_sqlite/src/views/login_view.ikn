import html
import views.layout

export fn render(error: str) -> str {
  let h0 = html.h1("Login")
  let h1 = html.p(error)
  let h2 = "<form method=\"post\" action=\"/login\"><input name=\"email\" /><input name=\"password\" type=\"password\" /><button>Entrar</button></form>"
  let body = str.concat(h0, str.concat(h1, h2))
  layout.render("Login", body)
}
